---
import Base from '../layouts/Base.astro';
import Lockup from '../components/Lockup.astro';
import PlayDiagram from '../components/PlayDiagram.astro';
import Showcase from '../components/Showcase.astro';

// TODO: swap for the real inbox once it exists
const email = 'hello@southernplaybook.com';
const mailto = `mailto:${email}?subject=${encodeURIComponent("Let's sit down")}`;

const questions = [
  'I know I should be using AI. Where do I even start?',
  "We're busy, but I can't tell where the money is leaking.",
  "I've got years of past customers and no way to reach them.",
];

const steps = [
  {
    n: '01',
    name: 'Scouting Report',
    body: "We sit down, mostly listen, and look at every part of the business — how leads come in, how jobs get booked, how you follow up, what people say about you online.",
  },
  {
    n: '02',
    name: 'Game Plan',
    body: 'You get Your Playbook: the two or three moves that matter most right now, in plain English, ranked, with a fixed price on each. No 60-page report.',
  },
  {
    n: '03',
    name: 'Moving the Chains',
    body: "We build the first fix with you, measure what changes, and line up the next one. You'll see results in weeks, not quarters.",
  },
];

const fixes = [
  { title: 'Win back past customers', body: 'Your old customer list is the fastest money you have. We set up simple texts and emails that bring people back.' },
  { title: 'Show up every week', body: 'Posts and emails built from your own words and know-how, so they sound like you. You approve, we keep it going.' },
  { title: 'Answer every lead fast', body: 'Missed calls, slow replies and forms nobody checks cost jobs. We set up follow-up that happens even when you\'re on a job site.' },
  { title: 'A website that books work', body: 'Fast, clear, and built around the one thing you want visitors to do — call, book, or order.' },
];
---
<Base>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header" data-header>
    <div class="wrap bar">
      <a href="/" class="home" aria-label="Southern Playbook home"><Lockup size={40} /></a>
      <nav aria-label="Main">
        <a href="#how">How it works</a>
        <a href="#samples">Sample sites</a>
        <a class="btn btn--small" href="#talk">Let's talk</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="label" data-reveal>Madison, MS · Jackson metro</p>
          <h1 data-reveal style="--i:1">Find what's slowing your business down. Fix that first.</h1>
          <p class="lede" data-reveal style="--i:2">
            We dig into your business with help from the latest AI tools, find what's slowing you down, and hand you a clear plan to grow faster.
          </p>
          <div class="ctas" data-reveal style="--i:3">
            <a class="btn" href="#talk">Let's sit down
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="btn btn--ghost" href="#how">See how it works</a>
          </div>
          <ul class="proof" data-reveal style="--i:4">
            <li>Plain English</li><li>Fixed prices</li><li>Results you can see this month</li>
          </ul>
        </div>
        <div class="hero-art" data-reveal style="--i:2">
          <PlayDiagram />
        </div>
      </div>
    </section>

    <!-- WHAT WE HEAR -->
    <section class="section hear">
      <div class="wrap">
        <div class="section-head">
          <p class="label" data-reveal>What owners tell us</p>
          <h2 data-reveal style="--i:1">You know something needs to change. You don't have time to figure out what.</h2>
        </div>
        <ul class="quotes">
          {questions.map((q, i) => (
            <li data-reveal style={`--i:${i}`}><span aria-hidden="true">“</span>{q}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section how" id="how">
      <div class="wrap">
        <div class="section-head">
          <p class="label" data-reveal>How it works</p>
          <h2 data-reveal style="--i:1">Three steps. You'll always know what's next.</h2>
        </div>
        <ol class="steps" data-reveal>
          {steps.map((s, i) => (
            <li style={`--i:${i}`}>
              <span class="num">{s.n}</span>
              <h3>{s.name}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- FIRST FIXES -->
    <section class="section fixes">
      <div class="wrap">
        <div class="section-head">
          <p class="label" data-reveal>Where most businesses start</p>
          <h2 data-reveal style="--i:1">Small fixes that pay for themselves.</h2>
          <p data-reveal style="--i:2">Every business is different, but these come up again and again. We'll tell you honestly which ones are worth it for you.</p>
        </div>
        <div class="cards">
          {fixes.map((f, i) => (
            <article class="card" data-reveal style={`--i:${i}`}>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SAMPLES -->
    <section class="section samples" id="samples">
      <div class="wrap">
        <div class="section-head">
          <p class="label" data-reveal>Sample sites</p>
          <h2 data-reveal style="--i:1">Here's what your website could look like.</h2>
          <p data-reveal style="--i:2">Clean, quick to load, and built to get people to call, book or order.</p>
        </div>
        <div data-reveal style="--i:3"><Showcase /></div>
      </div>
    </section>

    <!-- WHO -->
    <section class="section who">
      <div class="wrap who-grid">
        <div>
          <p class="label" data-reveal>Who you'll sit down with</p>
        </div>
        <div class="who-copy">
          <h2 data-reveal>A neighbor who's spent two decades making complicated things simple.</h2>
          <p data-reveal style="--i:1">
            I'm Rob Armstrong. I've led product design teams at Turner, WarnerMedia and Warner Bros. Discovery, building things millions of people use every day. Now I bring that same work — and today's AI tools — to businesses right here at home. You'll get straight answers, and I'll tell you when something isn't worth your money.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section talk" id="talk">
      <div class="wrap talk-card" data-reveal>
        <div>
          <h2>Let's sit down.</h2>
          <p>Coffee's on me. Bring your questions — I'll mostly listen, then tell you the first thing I'd fix.</p>
        </div>
        <div class="talk-actions">
          <a class="btn" href={mailto}>Email {email}</a>
          <span class="where">Serving Madison, Ridgeland, Flowood, Brandon and the Jackson metro</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap foot">
      <Lockup size={56} tagline />
      <p class="fine">© {new Date().getFullYear()} Southern Playbook · Madison, Mississippi</p>
    </div>
  </footer>
</Base>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--field-ink); color: var(--field); padding: 8px 12px; border-radius: 6px; z-index: 100; }
  .skip:focus { left: 8px; }

  /* Header */
  .site-header { position: sticky; top: 0; z-index: 50; transition: background 250ms, box-shadow 250ms; }
  .site-header.is-scrolled { background: rgb(36 36 36 / 0.86); backdrop-filter: blur(10px); box-shadow: 0 1px 0 var(--field-line); }
  .bar { display: flex; justify-content: space-between; align-items: center; padding-block: 16px; }
  .home { text-decoration: none; }
  nav { display: flex; align-items: center; gap: clamp(14px, 3vw, 32px); font-weight: 600; font-size: var(--step--1); }
  nav a:not(.btn) { color: var(--field-muted); text-decoration: none; transition: color 150ms; }
  nav a:not(.btn):hover { color: var(--field-ink); }
  .btn--small { padding: 0.6em 1.1em; }
  @media (max-width: 640px) { nav a:not(.btn) { display: none; } }

  /* Hero */
  .hero { padding-block: clamp(40px, 7vw, 96px) clamp(64px, 9vw, 120px); position: relative; overflow: clip; }
  .hero::before {
    /* faint notebook rules behind the hero */
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(to bottom, transparent 0 39px, var(--field-line) 39px 40px);
    mask-image: linear-gradient(to bottom, #000, transparent 85%);
    opacity: 0.6;
  }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; position: relative; }
  .hero-copy { display: grid; gap: 24px; }
  h1 { font-size: var(--step-4); }
  .lede { font-size: var(--step-1); max-width: 34rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .proof { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: var(--step--1); color: var(--field-ink); font-weight: 600; }
  .proof li { display: flex; align-items: center; gap: 8px; }
  .proof li::before { content: ''; width: 8px; height: 8px; border-radius: 2px; background: var(--accent); }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { max-width: 560px; } }

  /* What we hear */
  .hear { background: var(--field-sunk); }
  .quotes { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .quotes li { font-size: var(--step-1); color: var(--field-ink); font-weight: 600; line-height: 1.35; padding: 28px; border: 1px solid var(--field-line); border-radius: var(--radius); background: var(--field); }
  .quotes span { display: block; font-size: 3rem; line-height: 0.6; color: var(--accent); font-weight: 800; margin-bottom: 8px; }
  @media (max-width: 820px) { .quotes { grid-template-columns: 1fr; } }

  /* Steps — a yard-line track draws across as they reveal */
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 48px); position: relative; padding-top: 44px; }
  .steps::before { content: ''; position: absolute; left: 0; right: 0; top: 10px; height: 2px; background: var(--field-line-strong); transform: scaleX(0); transform-origin: left; transition: transform 1400ms var(--ease-out) 200ms; }
  .steps.is-in::before, html:not(.js) .steps::before { transform: none; }
  .steps li { display: grid; gap: 12px; align-content: start; position: relative; }
  .js .steps li { opacity: 0; transform: translateY(20px); transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out); transition-delay: calc(300ms + var(--i) * 260ms); }
  .js .steps.is-in li { opacity: 1; transform: none; }
  .js .steps[data-reveal] { opacity: 1; transform: none; }
  .steps li::before { content: ''; position: absolute; top: -41px; left: 0; width: 18px; height: 18px; border-radius: 50%; background: var(--field); border: 3px solid var(--field-ink); }
  .num { font-weight: 800; color: var(--accent); font-size: var(--step--1); letter-spacing: 0.08em; }
  .steps h3 { font-size: var(--step-2); }
  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; padding-top: 0; padding-left: 40px; }
    .steps::before { left: 8px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; transform: scaleY(0); transform-origin: top; }
    .steps.is-in::before { transform: none; }
    .steps li::before { top: 2px; left: -40px; }
  }

  /* Fixes */
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .card { padding: 28px 24px 30px; border-radius: var(--radius); background: var(--field-raised); border: 1px solid var(--field-line); display: grid; gap: 12px; align-content: start; transition: transform 250ms var(--ease-out), border-color 250ms; }
  .card:hover { transform: translateY(-4px); border-color: var(--field-line-strong); }
  .card h3 { font-size: var(--step-1); }
  @media (max-width: 1000px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }

  /* Samples */
  .samples { background: linear-gradient(to bottom, var(--field), var(--field-sunk)); }

  /* Who */
  .who-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 32px; }
  .who-copy { display: grid; gap: 20px; }
  .who-copy h2 { font-size: var(--step-3); }
  .who-copy p { font-size: var(--step-1); max-width: 44rem; }
  @media (max-width: 820px) { .who-grid { grid-template-columns: 1fr; } }

  /* Talk */
  .talk-card {
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: end;
    padding: clamp(32px, 6vw, 72px); border-radius: calc(var(--radius) * 1.6);
    background: var(--chalk); color: var(--graphite);
  }
  .talk-card h2 { color: var(--graphite); font-size: var(--step-4); margin-bottom: 16px; }
  .talk-card p { font-size: var(--step-1); }
  .talk-card .btn { --bg: var(--graphite); --fg: var(--chalk); }
  .talk-actions { display: grid; gap: 14px; justify-items: start; }
  .where { font-size: var(--step--1); color: #5a5a55; }
  @media (max-width: 820px) { .talk-card { grid-template-columns: 1fr; } }

  /* Footer */
  .site-footer { border-top: 1px solid var(--field-line); padding-block: 48px 40px; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 28px; }
  .fine { font-size: var(--step--1); color: var(--field-dim); }
</style>
