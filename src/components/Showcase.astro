---
/**
 * "What your site could look like." Pick an industry, see a site for it.
 * Tree service is Rankin Tree Service (a live site we built); every other
 * sample is a concept for a made-up business, drawn in CSS/SVG.
 * Auto-rotates while on screen (pauses on hover; stops once someone picks
 * an industry; off for reduced motion). Industry buttons are real tabs.
 *
 * To add an industry: make src/components/samples/<Name>.astro (copy one),
 * then add it to `samples` below. Order here = order in the grid.
 */
import Tree from './samples/Tree.astro';
import Electrician from './samples/Electrician.astro';
import Plumber from './samples/Plumber.astro';
import Roofer from './samples/Roofer.astro';
import Framer from './samples/Framer.astro';
import Contractor from './samples/Contractor.astro';
import Cleaners from './samples/Cleaners.astro';
import Chiro from './samples/Chiro.astro';
import Dentist from './samples/Dentist.astro';
import Bbq from './samples/Bbq.astro';
import Lawyer from './samples/Lawyer.astro';
import Banker from './samples/Banker.astro';

const samples = [
  { id: 'tree', label: 'Tree service', url: 'rankintreeservice.com', C: Tree },
  { id: 'elec', label: 'Electrician', url: 'copperlineelectric.example', C: Electrician },
  { id: 'plumb', label: 'Plumber', url: 'steadyflowplumbing.example', C: Plumber },
  { id: 'roof', label: 'Roofer', url: 'highridgeroofing.example', C: Roofer },
  { id: 'frame', label: 'Framer', url: 'truesquareframing.example', C: Framer },
  { id: 'build', label: 'Contractor', url: 'magnoliabuild.example', C: Contractor },
  { id: 'clean', label: 'House cleaning', url: 'frontporchcleaning.example', C: Cleaners },
  { id: 'chiro', label: 'Chiropractor', url: 'northsidechiro.example', C: Chiro },
  { id: 'dent', label: 'Dentist', url: 'liveoakdental.example', C: Dentist },
  { id: 'bbq', label: 'BBQ joint', url: 'hickoryandash.example', C: Bbq },
  { id: 'law', label: 'Lawyer', url: 'halerowelaw.example', C: Lawyer },
  { id: 'bank', label: 'Community bank', url: 'sweetgumbank.example', C: Banker },
];
---
<div class="showcase" data-showcase>
  <div class="tabs" role="tablist" aria-label="Sample sites by industry">
    {samples.map((s, i) => (
      <button role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={i}>
        {s.label}
        <span class="bar" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <div class="browser">
    <div class="chrome" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="url" data-url>{samples[0].url}</span>
    </div>
    <div class="stage">
      {samples.map((s, i) => <s.C id={s.id} url={s.url} active={i === 0} />)}
    </div>
  </div>
  <p class="note">Tree service is <a href="https://rankintreeservice.com" target="_blank" rel="noopener">Rankin Tree Service</a>, a live site we built. The rest are concepts for made-up businesses. Your site gets built around your customers, your voice, and what you want people to do next.</p>
</div>

<style>
  .showcase { display: grid; gap: 18px; }

  /* Industry grid (a tablist). Wraps into rows on wide screens, scrolls sideways on phones. */
  .tabs { position: relative; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .tabs button {
    position: relative; overflow: hidden; text-align: left;
    font: 700 var(--step--1)/1.1 var(--font-body);
    color: var(--field-muted); background: transparent;
    border: 1px solid var(--field-line-strong); border-radius: 10px;
    padding: 0.85em 1em; cursor: pointer; white-space: nowrap;
    transition: color 200ms, background 200ms, border-color 200ms;
  }
  .tabs button:hover { color: var(--field-ink); border-color: var(--field-ink); }
  .tabs button[aria-selected='true'] { color: var(--field); background: var(--field-ink); border-color: var(--field-ink); }
  .tabs button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .bar { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--graphite); /* on the chalk button: mustard is too faint there */ transform: scaleX(0); transform-origin: left; }
  .showcase.is-playing button[aria-selected='true'] .bar { animation: progress var(--rotate, 6s) linear forwards; }
  .showcase.is-paused button[aria-selected='true'] .bar { animation-play-state: paused; }
  @keyframes progress { to { transform: scaleX(1); } }
  @media (max-width: 640px) {
    .tabs {
      display: flex; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter)); padding: 2px var(--gutter) 4px;
    }
    .tabs::-webkit-scrollbar { display: none; }
    .tabs button { flex: none; scroll-snap-align: start; }
  }

  .browser {
    border-radius: 14px; overflow: hidden;
    background: #fff;
    box-shadow: 0 50px 100px -40px rgb(0 0 0 / 0.75), 0 0 0 1px var(--field-line);
  }
  .chrome { display: flex; align-items: center; gap: 14px; padding: 10px 14px; background: #e9ebee; }
  .dots { display: flex; gap: 6px; } .dots i { width: 10px; height: 10px; border-radius: 50%; background: #c6cbd2; }
  .url { flex: 1; max-width: 320px; font: 500 12px/1 var(--font-body); color: #5b6472; background: #fff; border-radius: 6px; padding: 7px 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stage { position: relative; aspect-ratio: 16 / 10; min-height: 420px; overflow: hidden; container-type: inline-size; }
  @media (max-width: 560px) { .stage { aspect-ratio: auto; min-height: 460px; } }

  .note { font-size: var(--step--1); color: var(--field-dim); max-width: 60ch; }
  .note a { color: var(--field-ink); text-underline-offset: 3px; }
</style>

<!-- Shared building blocks for every sample site (samples/*.astro add their own look). -->
<style is:global>
  :where(.showcase) .site { position: absolute; inset: 0; padding: clamp(18px, 4cqi, 40px); display: flex; flex-direction: column; gap: 3cqi; overflow: hidden; }
  :where(.showcase) .site[hidden] { display: none; }
  :where(.showcase) .site.is-active > * { animation: siteIn 700ms var(--ease-out) both; }
  :where(.showcase) .site.is-active > *:nth-child(2) { animation-delay: 90ms; }
  :where(.showcase) .site.is-active > *:nth-child(3) { animation-delay: 180ms; }
  @keyframes siteIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  :where(.showcase) .s-nav { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: clamp(11px, 1.6cqi, 15px); }
  :where(.showcase) .s-nav b { letter-spacing: 0.04em; }
  :where(.showcase) .s-call { font-weight: 700; white-space: nowrap; }
  :where(.showcase .site) h3 { font-size: clamp(24px, 5.6cqi, 54px); line-height: 1.02; letter-spacing: -0.02em; color: inherit; margin: 0; }
  :where(.showcase) .s-hero { display: grid; gap: 1.6cqi; max-width: 60ch; position: relative; z-index: 1; }
  :where(.showcase) .s-hero.half { max-width: 54%; }
  :where(.showcase) .s-eyebrow { font-size: clamp(10px, 1.3cqi, 13px); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  :where(.showcase) .s-sub { font-size: clamp(12px, 1.8cqi, 17px); line-height: 1.5; max-width: 46ch; opacity: 0.85; margin: 0; }
  :where(.showcase) .s-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  :where(.showcase) .s-btn, :where(.showcase) .s-ghost { font-weight: 700; font-size: clamp(12px, 1.6cqi, 15px); padding: 0.8em 1.2em; border-radius: 8px; }
  :where(.showcase) .s-ghost { border: 2px solid currentColor; }
  :where(.showcase) .s-btn { position: relative; overflow: hidden; }
  :where(.showcase) .s-btn::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.35) 50%, transparent 70%); transform: translateX(-120%); animation: shine 3.2s ease-in-out 1.2s infinite; }
  @keyframes shine { 40%, 100% { transform: translateX(120%); } }

  /* Illustration slot on the right; positioned with insets (not transforms) so the
     shared fade-in can animate it. Hidden when the frame is phone-narrow. */
  :where(.showcase) .s-art { position: absolute; right: clamp(18px, 4cqi, 40px); top: 16%; bottom: 8%; width: 40%; display: grid; place-items: center; pointer-events: none; }
  :where(.showcase) .s-art svg { width: 100%; height: 100%; overflow: visible; }
  :where(.showcase) .draw { stroke-dasharray: 1; stroke-dashoffset: 0; }
  /* Narrow frames (phones): text on top, illustration centered underneath */
  @container (max-width: 620px) {
    :where(.showcase) .s-hero.half { max-width: 100%; }
    :where(.showcase) .s-art { top: auto; bottom: 4%; left: 18%; right: 18%; width: auto; height: 38%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase *, .showcase *::before, .showcase *::after { animation: none !important; }
  }
</style>
