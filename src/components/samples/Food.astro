---
interface Props { id: string; url: string; active?: boolean }
const { id, url, active = false } = Astro.props;
---
<!-- Restaurant (made-up): the lid lifts off a plate, steam rises, and a pickup order is ready -->
<section class:list={['site', 'food', { 'is-active': active }]} role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} data-panel data-url-value={url} hidden={!active}>
  <header class="s-nav"><b>Porch Light <span>Kitchen</span></b><span class="s-call">Open today 11–9</span></header>
  <div class="s-hero half">
    <p class="s-eyebrow">Lunch · Dinner · Catering</p>
    <h3>Order ahead.<br />Skip the line.</h3>
    <p class="s-sub">Southern plates made from scratch. Order online for pickup, or book catering for your next event.</p>
    <div class="s-ctas"><span class="s-btn">Order online</span><span class="s-ghost">See the menu</span></div>
  </div>
  <div class="s-ticker" aria-hidden="true"><div><span>Chicken &amp; waffles $14</span><span>Shrimp &amp; grits $16</span><span>Meat &amp; three $13</span><span>Fried catfish plate $15</span><span>Peach cobbler $6</span><span>Chicken &amp; waffles $14</span><span>Shrimp &amp; grits $16</span><span>Meat &amp; three $13</span><span>Fried catfish plate $15</span><span>Peach cobbler $6</span></div></div>
  <div class="s-art" aria-hidden="true">
    <svg viewBox="0 0 260 240">
      <rect x="0" y="168" width="260" height="10" rx="5" fill="#e3d3bb" />
      <ellipse cx="130" cy="160" rx="104" ry="18" fill="#efe4d3" />
      <ellipse cx="130" cy="156" rx="96" ry="15" fill="#ffffff" stroke="#e0d2bd" stroke-width="2" />
      <g class="dish">
        <ellipse cx="108" cy="146" rx="34" ry="12" fill="#e9b44c" />
        <ellipse cx="104" cy="141" rx="24" ry="8" fill="#f2c96a" />
        <ellipse cx="156" cy="146" rx="26" ry="10" fill="#5f8f45" />
        <circle cx="148" cy="141" r="6" fill="#7aac56" /><circle cx="160" cy="139" r="7" fill="#6c9f4c" /><circle cx="168" cy="144" r="5" fill="#7aac56" />
        <circle cx="128" cy="150" r="7" fill="#c8452c" /><circle cx="133" cy="146" r="4" fill="#e05c40" />
      </g>
      <g class="steam" fill="none" stroke="#b9a891" stroke-width="3.5" stroke-linecap="round">
        <path class="draw s1" pathLength="1" d="M104 128 c -10 -14, 10 -22, 0 -38 s 8 -22, 0 -34" />
        <path class="draw s2" pathLength="1" d="M130 126 c -10 -14, 10 -22, 0 -40 s 8 -22, 0 -34" />
        <path class="draw s3" pathLength="1" d="M156 128 c -10 -14, 10 -22, 0 -38 s 8 -22, 0 -34" />
      </g>
      <g class="lid" style="transform-origin:212px 150px">
        <path d="M44 150 a86 76 0 0 1 172 0 z" fill="#d7dbe0" />
        <path d="M58 140 a76 64 0 0 1 60 -58" fill="none" stroke="#ffffff" stroke-width="6" stroke-linecap="round" opacity="0.7" />
        <rect x="38" y="146" width="184" height="8" rx="4" fill="#b8bec6" />
        <circle cx="130" cy="70" r="9" fill="#b8bec6" />
      </g>
      <g class="chip">
        <rect x="44" y="196" width="172" height="30" rx="15" fill="#2d1d14" />
        <text x="130" y="215" text-anchor="middle" fill="#fff" font-size="11" font-weight="700">✓ Order #214 ready at 12:15</text>
      </g>
    </svg>
  </div>
</section>

<style>
  .food { background: radial-gradient(90% 90% at 80% 40%, #fff7ea, #f6ead6 70%); color: #2d1d14; }
  .food .s-nav b span { font-weight: 400; margin-left: 4px; }
  .food .s-call { background: #2d1d14; color: #fff7ea; padding: 0.5em 0.9em; border-radius: 999px; }
  .food .s-eyebrow { color: #b8361e; }
  .food .s-btn { background: #b8361e; color: #fff; }
  /* Scrolling menu along the bottom (carried over from the BBQ sample) */
  .food .s-ticker { margin: auto calc(-1 * clamp(18px, 4cqi, 40px)) calc(-1 * clamp(18px, 4cqi, 40px)); border-top: 1px solid #e3d3bb; background: #2d1d14; color: #fff7ea; padding: 1.1cqi 0; overflow: hidden; white-space: nowrap; font-weight: 700; font-size: clamp(11px, 1.5cqi, 14px); text-transform: uppercase; letter-spacing: 0.08em; position: relative; z-index: 2; }
  .food .s-ticker div { display: inline-flex; gap: 40px; animation: food-tick 26s linear infinite; }
  .food .s-ticker span::before { content: '●'; color: #e9b44c; margin-right: 12px; font-size: 0.7em; vertical-align: middle; }
  @keyframes food-tick { to { transform: translateX(-50%); } }
  .food .s-art { bottom: 15%; }
  /* Final (and reduced-motion) state: lid off to the side, steam visible */
  .lid { transform-box: view-box; transform: translate(70px, -60px) rotate(28deg); opacity: 0; }
  .steam { opacity: 0.9; }
  @media (prefers-reduced-motion: no-preference) {
    .food.is-active .lid { animation: food-lift 1.1s cubic-bezier(0.5, 0, 0.2, 1) 0.9s both; }
    .food.is-active .steam path { animation: food-steam 2.6s ease-in-out infinite; }
    .food.is-active .s1 { animation-delay: 1.6s; } .food.is-active .s2 { animation-delay: 1.9s; } .food.is-active .s3 { animation-delay: 2.2s; }
    .food.is-active .chip { animation: food-chip 600ms var(--ease-out) 2.4s both; }
  }
  @keyframes food-lift {
    0% { transform: none; opacity: 1; }
    35% { transform: translateY(-14px) rotate(-3deg); opacity: 1; }
    100% { transform: translate(70px, -60px) rotate(28deg); opacity: 0; }
  }
  @keyframes food-steam {
    0% { stroke-dashoffset: 1; opacity: 0; transform: translateY(6px); }
    30% { opacity: 0.9; }
    70% { stroke-dashoffset: 0; opacity: 0.6; }
    100% { stroke-dashoffset: 0; opacity: 0; transform: translateY(-16px); }
  }
  @keyframes food-chip { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>
