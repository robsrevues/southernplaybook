---
interface Props { id: string; url: string; active?: boolean }
const { id, url, active = false } = Astro.props;
---
<!-- Dentist (made-up): a light sweeps across a tooth, it sparkles, and a cleaning gets booked -->
<section class:list={['site', 'dent', { 'is-active': active }]} role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} data-panel data-url-value={url} hidden={!active}>
  <header class="s-nav"><b>Live Oak <span>Family Dentistry</span></b><span class="s-call">Book online</span></header>
  <div class="s-hero half">
    <p class="s-eyebrow">New patients welcome</p>
    <h3>Gentle dentistry for the whole family.</h3>
    <p class="s-sub">Cleanings, crowns and clear aligners, with evening and Saturday hours. Most insurance accepted.</p>
    <div class="s-ctas"><span class="s-btn">Book a cleaning</span><span class="s-ghost">Check my insurance</span></div>
  </div>
  <div class="s-art" aria-hidden="true">
    <svg viewBox="0 0 240 240">
      <defs>
        <clipPath id="dent-tooth"><path d="M70 50 C 70 26, 100 24, 120 38 C 140 24, 170 26, 170 50 C 172 92, 160 110, 156 150 C 152 184, 144 198, 136 198 C 126 198, 128 152, 120 152 C 112 152, 114 198, 104 198 C 96 198, 88 184, 84 150 C 80 110, 68 92, 70 50 Z" /></clipPath>
        <linearGradient id="dent-shine" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset="0.5" stop-color="#fff" stop-opacity="0.95" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
      </defs>
      <circle cx="120" cy="112" r="100" fill="#d9f1ef" />
      <path d="M70 50 C 70 26, 100 24, 120 38 C 140 24, 170 26, 170 50 C 172 92, 160 110, 156 150 C 152 184, 144 198, 136 198 C 126 198, 128 152, 120 152 C 112 152, 114 198, 104 198 C 96 198, 88 184, 84 150 C 80 110, 68 92, 70 50 Z" fill="#ffffff" stroke="#0f7c85" stroke-width="5" stroke-linejoin="round" />
      <g clip-path="url(#dent-tooth)"><polygon class="shine" points="40,10 84,10 44,230 0,230" fill="url(#dent-shine)" /></g>
      <g class="spark" style="transform-origin:178px 44px"><path d="M178 26 L182 40 L196 44 L182 48 L178 62 L174 48 L160 44 L174 40Z" fill="#14b8a6" /></g>
      <g class="chip">
        <rect x="58" y="206" width="124" height="28" rx="14" fill="#0e3b43" />
        <text x="120" y="224" text-anchor="middle" fill="#fff" font-size="11" font-weight="700">✓ Thu 4:30 booked</text>
      </g>
    </svg>
  </div>
</section>

<style>
  .dent { background: radial-gradient(80% 90% at 85% 40%, #eaf8f7, #ffffff 70%); color: #0e3b43; }
  .dent .s-nav b span { font-weight: 400; margin-left: 4px; }
  .dent .s-call { background: #0f7c85; color: #fff; padding: 0.5em 0.9em; border-radius: 999px; }
  .dent .s-eyebrow { color: #0f7c85; }
  .dent .s-btn { background: #0f7c85; color: #fff; }
  .shine { opacity: 0; }
  .spark { transform-box: view-box; }
  @media (prefers-reduced-motion: no-preference) {
    .dent.is-active .shine { animation: dent-sweep 1.3s ease-in-out 0.7s both, dent-sweep 1.3s ease-in-out 4.5s both; }
    .dent.is-active .spark { animation: dent-pop 700ms cubic-bezier(0.34, 1.6, 0.64, 1) 1.7s both, dent-twinkle 2.4s ease-in-out 2.6s infinite; }
    .dent.is-active .chip { animation: dent-chip 600ms var(--ease-out) 2.2s both; }
  }
  @keyframes dent-sweep { from { opacity: 1; transform: translateX(-30px); } to { opacity: 1; transform: translateX(190px); } }
  @keyframes dent-pop { from { opacity: 0; transform: scale(0) rotate(-60deg); } to { opacity: 1; transform: none; } }
  @keyframes dent-twinkle { 0%, 70%, 100% { transform: scale(1); } 85% { transform: scale(0.65) rotate(25deg); } }
  @keyframes dent-chip { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>
