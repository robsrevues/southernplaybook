---
interface Props { id: string; url: string; active?: boolean }
const { id, url, active = false } = Astro.props;
---
      <!-- 2 · Chiropractor -->
      <section class:list={["site", "chiro", { "is-active": active }]} role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} data-panel data-url-value={url} hidden={!active}>
        <header class="s-nav"><b>Northside <span>Chiropractic</span></b><span class="s-call">Book online</span></header>
        <div class="s-grid">
          <div class="s-hero">
            <p class="s-pill">New · Laser therapy</p>
            <h3>Knee and back pain relief, without the wait.</h3>
            <p class="s-sub">Non-invasive laser sessions in about 10 minutes. Most patients feel a difference in the first few visits.</p>
            <span class="s-btn">See if it's right for you</span>
          </div>
          <div class="s-side">
            <div class="spine" aria-hidden="true"><i style="--x:14%;--r:-8deg;--i:0;--w:0.78"></i><i style="--x:26%;--r:6deg;--i:1;--w:0.82"></i><i style="--x:34%;--r:10deg;--i:2;--w:0.85"></i><i style="--x:22%;--r:-4deg;--i:3;--w:0.89"></i><i style="--x:4%;--r:-9deg;--i:4;--w:0.92"></i><i style="--x:-14%;--r:-6deg;--i:5;--w:0.96"></i><i style="--x:-26%;--r:7deg;--i:6;--w:0.99"></i><i style="--x:-18%;--r:11deg;--i:7;--w:1.03"></i><i style="--x:-6%;--r:4deg;--i:8;--w:1.06"></i></div>
          <div class="s-book" aria-hidden="true">
            <p>This week</p>
            <div class="slots">
              <span>Tue 9:00</span><span>Tue 2:30</span><span class="pick">Wed 8:15</span><span>Thu 11:00</span><span>Fri 4:45</span><span class="gone">Sat 9:30</span>
            </div>
            <span class="s-confirm">✓ Wed 8:15 held for you</span>
          </div>
          </div>
        </div>
      </section>

<style>
  /* Chiro */
  .chiro { background: linear-gradient(160deg, #fbf7f2, #efe4d8); color: #3b2a22; }
  .chiro .s-nav b { letter-spacing: 0; font-weight: 800; } .chiro .s-nav b span { font-weight: 400; }
  .chiro .s-call { background: #3b2a22; color: #fbf7f2; padding: 0.5em 0.9em; border-radius: 999px; }
  .s-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 4cqi; align-items: center; flex: 1; }
  .s-pill { justify-self: start; background: #e8c9ad; color: #5a3423; font-weight: 700; font-size: clamp(11px, 1.4cqi, 13px); padding: 0.45em 0.9em; border-radius: 999px; }
  .chiro .s-btn { background: #b4583a; color: #fff; justify-self: start; }
  /* Spine: vertebrae settle into line, then a warm relief glow runs down once */
  .s-side { display: grid; grid-template-columns: auto 1fr; gap: 3cqi; align-items: center; }
  .spine { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.7cqi; padding: 1cqi 0.6cqi; }
  .spine i {
    display: block; width: calc(5cqi * var(--w)); height: 2.3cqi; border-radius: 45% / 60%;
    background: linear-gradient(180deg, #ecd3bb, #d8b392); box-shadow: inset 0 -2px 0 rgb(59 42 34 / 0.12);
    position: relative;
  }
  .spine i::before, .spine i::after { content: ''; position: absolute; top: 30%; width: 22%; height: 40%; border-radius: 40%; background: #dcbb9c; }
  .spine i::before { left: -16%; } .spine i::after { right: -16%; }
  .spine::after {
    content: ''; position: absolute; left: -30%; right: -30%; top: 0; height: 22%;
    background: radial-gradient(closest-side, rgb(255 190 140 / 0.75), transparent);
    opacity: 0; pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .chiro.is-active .spine i {
      animation: align 1000ms cubic-bezier(0.34, 1.3, 0.64, 1) both;
      animation-delay: calc(700ms + var(--i) * 80ms);
    }
    .chiro.is-active .spine::after { animation: relief 1.3s ease-in-out 2.3s both; }
  }
  @keyframes align { from { transform: translateX(var(--x)) rotate(var(--r)); } to { transform: none; } }
  @keyframes relief { 0% { opacity: 0; top: -10%; } 20% { opacity: 1; } 80% { opacity: 1; } 100% { opacity: 0; top: 88%; } }
  .s-book { background: #fff; border-radius: 14px; padding: 2.4cqi; box-shadow: 0 20px 40px -20px rgb(59 42 34 / 0.35); display: grid; gap: 1.4cqi; font-size: clamp(11px, 1.4cqi, 14px); }
  .s-book p { font-weight: 800; }
  .slots { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .slots span { border: 1.5px solid #e2d4c6; border-radius: 8px; padding: 0.6em; text-align: center; font-weight: 600; }
  .slots .gone { opacity: 0.35; text-decoration: line-through; }
  .chiro.is-active .slots .pick { animation: pick 600ms var(--ease-out) 1.3s both; }
  @keyframes pick { to { background: #b4583a; border-color: #b4583a; color: #fff; } }
  .s-confirm { color: #2f6b3c; font-weight: 700; }
  .chiro.is-active .s-confirm { animation: siteIn 500ms var(--ease-out) 1.8s both; }

  @media (prefers-reduced-motion: reduce) { .chiro .slots .pick { background: #b4583a; color: #fff; } }
  @container (max-width: 560px) { .s-book, .spine { display: none; } .s-side { display: block; } }
</style>
