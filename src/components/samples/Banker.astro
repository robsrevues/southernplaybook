---
interface Props { id: string; url: string; active?: boolean }
const { id, url, active = false } = Astro.props;
const bars = [44, 58, 54, 72, 84, 102];
---
<!-- Community bank (made-up): savings bars grow, a trend line draws over them, a loan gets approved -->
<section class:list={['site', 'bank', { 'is-active': active }]} role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} data-panel data-url-value={url} hidden={!active}>
  <header class="s-nav"><b>Sweet Gum <span>Community Bank</span></b><span class="s-call">Log in</span></header>
  <div class="s-hero half">
    <p class="s-eyebrow">Lending decisions made here, not out of state</p>
    <h3>A bank that knows your name.</h3>
    <p class="s-sub">Checking, small-business loans and mortgages, decided by people who live in your town.</p>
    <div class="s-ctas"><span class="s-btn">Open an account</span><span class="s-ghost">Talk to a lender</span></div>
  </div>
  <div class="s-art" aria-hidden="true">
    <svg viewBox="0 0 250 230">
      <rect x="8" y="14" width="234" height="190" rx="16" fill="#ffffff" stroke="#e4dfd3" />
      <text x="28" y="44" font-size="11" font-weight="700" fill="#5b6576">Business savings</text>
      <line x1="28" y1="170" x2="222" y2="170" stroke="#e4dfd3" />
      {bars.map((h, i) => (
        <g class="sbar" style={`transform-origin:${44 + i * 32}px 170px;--i:${i}`}><rect x={32 + i * 32} y={170 - h} width="24" height={h} rx="4" fill={i === bars.length - 1 ? '#2e7d5b' : '#b9d7c7'} /></g>
      ))}
      <path class="trend draw" pathLength="1" d={`M44 ${170 - bars[0] - 14} ${bars.map((h, i) => `L${44 + i * 32} ${170 - h - 14}`).join(' ')}`} fill="none" stroke="#1b2a41" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      <g class="chip">
        <rect x="42" y="186" width="166" height="30" rx="15" fill="#1b2a41" />
        <text x="125" y="205" text-anchor="middle" fill="#fff" font-size="11" font-weight="700">✓ Loan approved locally</text>
      </g>
    </svg>
  </div>
</section>

<style>
  .bank { background: #f7f5ef; color: #1b2a41; }
  .bank .s-nav b span { font-weight: 400; margin-left: 4px; }
  .bank .s-call { border: 2px solid #1b2a41; padding: 0.4em 0.9em; border-radius: 999px; }
  .bank .s-eyebrow { color: #2e7d5b; }
  .bank .s-btn { background: #1b2a41; color: #fff; }
  .sbar { transform-box: view-box; }
  @media (prefers-reduced-motion: no-preference) {
    .bank.is-active .sbar { animation: bank-grow 700ms cubic-bezier(0.34, 1.3, 0.64, 1) both; animation-delay: calc(500ms + var(--i) * 110ms); }
    .bank.is-active .trend { animation: bank-draw 1s ease-in-out 1.4s both; }
    .bank.is-active .chip { animation: bank-chip 600ms var(--ease-out) 2.3s both; }
  }
  @keyframes bank-grow { from { transform: scaleY(0); } to { transform: none; } }
  @keyframes bank-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes bank-chip { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>
