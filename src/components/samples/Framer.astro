---
interface Props { id: string; url: string; active?: boolean }
const { id, url, active = false } = Astro.props;
// Studs at 16" on center (scaled); the gap is a window opening with a header
const studs = [20, 52, 84, 172, 204, 236];
---
<!-- Framer (made-up): studs rise off the plate, the top plate slides on, then it checks square -->
<section class:list={['site', 'frame', { 'is-active': active }]} role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} data-panel data-url-value={url} hidden={!active}>
  <header class="s-nav"><b>True Square <span>Framing</span></b><span class="s-call">Request a bid</span></header>
  <div class="s-hero half">
    <p class="s-eyebrow">Residential &amp; light commercial</p>
    <h3>Plumb, level and on schedule.</h3>
    <p class="s-sub">Wall framing, trusses and additions for builders and homeowners. Crews that show up when they say.</p>
    <div class="s-ctas"><span class="s-btn">Get a bid</span><span class="s-ghost">For builders</span></div>
  </div>
  <div class="s-art" aria-hidden="true">
    <svg viewBox="0 0 270 230">
      <g stroke="#d8cdb8" stroke-width="1">
        {Array.from({ length: 10 }, (_, i) => <line x1="0" y1={i * 24} x2="270" y2={i * 24} />)}
        {Array.from({ length: 12 }, (_, i) => <line x1={i * 24} y1="0" x2={i * 24} y2="230" />)}
      </g>
      <rect x="10" y="196" width="250" height="12" rx="1.5" class="lumber" />
      {studs.map((x, i) => (
        <g class="stud" style={`transform-origin:${x + 6}px 196px;--i:${i}`}><rect x={x} y="40" width="12" height="156" rx="1.5" class="lumber" /></g>
      ))}
      <g class="stud" style="transform-origin:122px 196px;--i:3"><rect x="116" y="150" width="12" height="46" rx="1.5" class="lumber" /></g>
      <g class="stud" style="transform-origin:142px 196px;--i:3"><rect x="136" y="150" width="12" height="46" rx="1.5" class="lumber" /></g>
      <rect class="header" x="96" y="72" width="78" height="16" rx="1.5" fill="#b9864a" />
      <rect class="sill" x="96" y="140" width="78" height="10" rx="1.5" fill="#b9864a" />
      <rect class="plate" x="10" y="28" width="250" height="12" rx="1.5" fill="#b9864a" />
      <g class="square">
        <rect x="190" y="4" width="76" height="22" rx="11" fill="#2b2118" />
        <text x="228" y="19" text-anchor="middle" fill="#f6f1e7" font-size="11" font-weight="700">✓ Square</text>
      </g>
    </svg>
  </div>
</section>

<style>
  .frame { background: #f6f1e7; color: #2b2118; }
  .frame .s-nav b span { font-weight: 400; margin-left: 4px; }
  .frame .s-call { border: 2px solid #2b2118; padding: 0.4em 0.85em; border-radius: 999px; }
  .frame .s-eyebrow { color: #8a5a22; }
  .frame .s-btn { background: #2b2118; color: #f6f1e7; }
  .lumber { fill: #c89b5e; }
  .stud { transform-box: view-box; }
  @media (prefers-reduced-motion: no-preference) {
    .frame.is-active .stud { animation: frame-rise 650ms cubic-bezier(0.34, 1.3, 0.64, 1) both; animation-delay: calc(450ms + var(--i) * 140ms); }
    .frame.is-active .header, .frame.is-active .sill { animation: frame-drop 500ms var(--ease-out) 1.4s both; }
    .frame.is-active .plate { animation: frame-slide 700ms var(--ease-out) 1.7s both; }
    .frame.is-active .square { animation: frame-pop 450ms cubic-bezier(0.34, 1.6, 0.64, 1) 2.5s both; }
  }
  @keyframes frame-rise { from { transform: scaleY(0); } to { transform: none; } }
  @keyframes frame-drop { from { opacity: 0; transform: translateY(-16px); } to { opacity: 1; transform: none; } }
  @keyframes frame-slide { from { transform: translateX(290px); } to { transform: none; } }
  @keyframes frame-pop { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
</style>
