---
interface Props { id: string; url: string; active?: boolean }
const { id, url, active = false } = Astro.props;
---
      <!-- 3 · BBQ -->
      <section class:list={["site", "bbq", { "is-active": active }]} role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} data-panel data-url-value={url} hidden={!active}>
        <header class="s-nav"><b>HICKORY <span>&amp;</span> ASH</b><span class="s-call">Open 11–sold out</span></header>
        <div class="s-hero">
          <h3>Smoked low.<br /><em>Gone by two.</em></h3>
          <p class="s-sub">Order ahead and skip the line. We'll text you when it's on the counter.</p>
          <div class="s-ctas"><span class="s-btn">Order pickup</span><span class="s-ghost">Cater an event</span></div>
        </div>
        <div class="s-ticker" aria-hidden="true">
          <div><span>Brisket ½ lb $14</span><span>Pulled pork plate $12</span><span>Rib tips $11</span><span>Smoked chicken $10</span><span>Banana pudding $5</span><span>Brisket ½ lb $14</span><span>Pulled pork plate $12</span><span>Rib tips $11</span><span>Smoked chicken $10</span><span>Banana pudding $5</span></div>
        </div>
        <div class="embers" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      </section>

<style>
  /* BBQ */
  .bbq { background: radial-gradient(120% 90% at 85% 110%, #5a1f0c 0%, #1b1411 55%); color: #f6ead9; }
  .bbq .s-nav b { letter-spacing: 0.14em; } .bbq .s-nav b span { color: #ff8a3d; }
  .bbq .s-call { color: #ffb37a; }
  .bbq h3 { text-transform: uppercase; font-size: clamp(28px, 7cqi, 66px); }
  .bbq h3 em { font-style: normal; color: #ff8a3d; }
  .bbq .s-btn { background: #ff8a3d; color: #1b1411; }
  .bbq .s-ghost { border: 2px solid rgb(246 234 217 / 0.5); }
  .s-ticker { margin: auto calc(-1 * clamp(18px, 4cqi, 40px)) 0; border-block: 1px solid rgb(246 234 217 / 0.2); padding: 1.1cqi 0; overflow: hidden; white-space: nowrap; font-weight: 700; font-size: clamp(11px, 1.5cqi, 14px); text-transform: uppercase; letter-spacing: 0.08em; position: relative; z-index: 1; }
  .s-ticker div { display: inline-flex; gap: 40px; animation: tick 22s linear infinite; }
  .s-ticker span::before { content: '●'; color: #ff8a3d; margin-right: 12px; font-size: 0.7em; vertical-align: middle; }
  @keyframes tick { to { transform: translateX(-50%); } }
  .embers i { position: absolute; bottom: -10px; width: 5px; height: 5px; border-radius: 50%; background: #ff9c4a; box-shadow: 0 0 10px 2px #ff6a1a; opacity: 0; animation: ember 5s ease-in infinite; }
  .embers i:nth-child(1) { left: 62%; animation-delay: 0s; }
  .embers i:nth-child(2) { left: 74%; animation-delay: 1.1s; }
  .embers i:nth-child(3) { left: 83%; animation-delay: 2.3s; }
  .embers i:nth-child(4) { left: 91%; animation-delay: 0.6s; }
  .embers i:nth-child(5) { left: 69%; animation-delay: 3.2s; }
  .embers i:nth-child(6) { left: 87%; animation-delay: 4s; }
  @keyframes ember { 10% { opacity: 1; } 100% { opacity: 0; transform: translate(-30px, -320px) scale(0.4); } }
</style>
